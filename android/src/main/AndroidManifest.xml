<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Draw the bubble over other apps (the user grants it in Settings) -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Foreground service that keeps the app alive in the background -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

  <application>
    <service
      android:name="expo.modules.floatingbubbleoverlay.service.KeepAliveService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <!-- Android 14+: justification for the specialUse type (also declared in Google Play Console) -->
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Mientras el conductor esta conectado: mantiene la app activa para recibir solicitudes de viaje y muestra un acceso directo flotante para volver a ella desde otras apps" />
    </service>
  </application>
</manifest>
