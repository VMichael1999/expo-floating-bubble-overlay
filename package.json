{
  "name": "expo-floating-bubble-overlay",
  "version": "0.1.0",
  "description": "Floating chat-head bubble for Android that draws over other apps and brings your Expo app back to the foreground.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-floating-bubble-overlay",
    "FloatingBubbleOverlay"
  ],
  "repository": "https://github.com/VMichael1999/expo-floating-bubble-overlay",
  "bugs": {
    "url": "https://github.com/VMichael1999/expo-floating-bubble-overlay/issues"
  },
  "author": "Michael Valdiviezo <michaelino02@gmail.com> (https://github.com/VMichael1999)",
  "license": "MIT",
  "homepage": "https://github.com/VMichael1999/expo-floating-bubble-overlay#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.25",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/plugin/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
